<?xml version="1.0" encoding="UTF-8"?>
<Bundle xmlns="http://hl7.org/fhir">
  <type value="transaction"/>

  <!-- ========================================================= -->
  <!-- 1) ResearchStudy per conditional update                   -->
  <!-- ========================================================= -->
  <entry>
    <fullUrl value="<REPLACE_WITH_RESEARCHSTUDY_UUID>"/>

    <resource>
      <ResearchStudy>
        <meta>
          <profile value="https://www.medizininformatik-initiative.de/fhir/modul-studie/StructureDefinition/mii-pr-studie-studie"/>
        </meta>

        <identifier>
          <system value="<REPLACE-WITH-RESEARCHSTUDY_IDENTIFIER_SYSTEM>"/>
          <value value="<REPLACE-WITH-STUDY_IDENTIFIER_VALUE>"/>
        </identifier>

        <status value="<REPLACE-WITH-RESEARCHSTUDY_STATUS>"/>
        <title value="<REPLACE-WITH-RESEARCHSTUDY_TITLE>"/>
      </ResearchStudy>
    </resource>

    <request>
      <method value="PUT"/>
      <url value="ResearchStudy?identifier=<REPLACE-WITH-RESEARCHSTUDY_IDENTIFIER_SYSTEM>|<REPLACE-WITH-STUDY_IDENTIFIER_VALUE_URLENCODED>"/>
    </request>
  </entry>

  <!-- ========================================================= -->
  <!-- 2) ResearchSubject / Proband per conditional update       -->
  <!-- ========================================================= -->
  <entry>
    <fullUrl value="<REPLACE-WITH-RESEARCHSUBJECT_UUID>"/>

    <resource>
      <ResearchSubject>
        <meta>
          <profile value="https://www.medizininformatik-initiative.de/fhir/modul-studie/StructureDefinition/mii-pr-studie-proband"/>
        </meta>

        <identifier>
          <type>
            <coding>
              <system value="http://terminology.hl7.org/CodeSystem/v2-0203"/>
              <code value="ANON"/>
            </coding>
          </type>
          <system value="https://www.medizininformatik-initiative.de/fhir/sid/patienten"/>
          <value value="<REPLACE-WITH-RESEARCHSUBJECT_PSEUDONYM_VALUE>"/>
        </identifier>

        <status value="on-study"/>

        <period>
          <start value="<REPLACE-WITH-RESEARCHSUBJECT_PERIOD_START_YYYY-MM-DD>"/>
          <!-- optional:
          <end value="<REPLACE-WITH-RESEARCHSUBJECT_PERIOD_END_YYYY-MM-DD>"/>
          -->
        </period>

        <study>
          <reference value="<REPLACE_WITH_RESEARCHSTUDY_UUID>"/>
        </study>

        <individual>
          <reference value="Patient/<REPLACE-WITH-EXISTING_PATIENT_LOGICAL_ID>"/>
        </individual>

        <actualArm value="<ACTUAL_ARM>"/>
      </ResearchSubject>
    </resource>

    <request>
      <method value="PUT"/>
      <url value="ResearchSubject?identifier=https://www.medizininformatik-initiative.de/fhir/sid/patienten|<REPLACE-WITH-RESEARCHSUBJECT_PSEUDONYM_VALUE_URLENCODED>"/>
    </request>
  </entry>

</Bundle>