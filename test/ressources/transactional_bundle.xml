<?xml version="1.0" encoding="UTF-8"?>
<Bundle xmlns="http://hl7.org/fhir">
  <type value="transaction"/>

  <!-- ATMP project decision: ResearchSubject uses a fixed fallback -->
  <!-- participation start date and marks missing period end and    -->
  <!-- consent data as unknown via the FHIR data-absent-reason      -->
  <!-- extension.                                                   -->

  <!-- 1) ResearchStudy  -->
  <entry>
    <fullUrl value="ResearchStudy/atmp-study"/>
    <resource>
      <ResearchStudy>
        <id value="atmp-study"/>
        <meta>
          <profile value="https://www.medizininformatik-initiative.de/fhir/modul-studie/StructureDefinition/mii-pr-studie-studie"/>
        </meta>
        <identifier>
          <system value="https://ukhd.de/fhir/sid/research-study"/>
          <value value="ATMP"/>
        </identifier>
        <status value="active"/>
        <title value="ATMP Study"/>
      </ResearchStudy>
    </resource>
    <request>
      <method value="PUT"/>
      <url value="ResearchStudy/atmp-study"/>
    </request>
  </entry>

  <!-- 2) ResearchSubject  -->
  <entry>
    <fullUrl value="ResearchSubject/REPLACE_WITH_RESEARCHSUBJECT_ID"/>
    <resource>
      <ResearchSubject>
        <id value="REPLACE_WITH_RESEARCHSUBJECT_ID"/>
        <meta>
          <profile value="https://www.medizininformatik-initiative.de/fhir/modul-studie/StructureDefinition/mii-pr-studie-proband"/>
        </meta>
        <identifier>
          <type>
            <coding>
              <system value="http://terminology.hl7.org/CodeSystem/v2-0203"/>
              <code value="ANON"/>
            </coding>
          </type>
          <system value="https://ukhd.de/fhir/sid/atmp-pseudonym"/>
          <value value="REPLACE_WITH_RESEARCHSUBJECT_PSEUDONYM_VALUE"/>
        </identifier>
        <!--
          Use status as the primary DSF inclusion switch.
          Active value: on-study.
          Dropout/end values: off-study or withdrawn.
        -->
        <status value="REPLACE_WITH_RESEARCHSUBJECT_STATUS"/>    
        <period>
          <start value="2026-01-01"/>
          <end>
            <extension url="http://hl7.org/fhir/StructureDefinition/data-absent-reason">
              <valueCode value="unknown"/>
            </extension>
          </end>
        </period>
        <study>
          <reference value="ResearchStudy/atmp-study"/>
        </study>
        <individual>
          <reference value="Patient/REPLACE_WITH_EXISTING_PATIENT_ID"/>
        </individual>
        <consent>
          <extension url="http://hl7.org/fhir/StructureDefinition/data-absent-reason">
            <valueCode value="unknown"/>
          </extension>
        </consent>
      </ResearchSubject>
    </resource>
    <request>
      <method value="PUT"/>
      <url value="ResearchSubject/REPLACE_WITH_RESEARCHSUBJECT_ID"/>
    </request>
  </entry>
</Bundle>
