<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_atmp_data_transfer" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.42.0">
  <bpmn:message id="Message_atmpDataTransferStart" name="atmpDataTransferStart" />
  <bpmn:message id="Message_atmpDataTransferStop" name="atmpDataTransferStop" />
  <bpmn:process id="ukhdde_atmpDataTransfer" isExecutable="true" camunda:versionTag="#{version}">
    <bpmn:startEvent id="StartEvent_atmpDataTransfer" name="start ATMP data transfer">
      <bpmn:outgoing>Flow_start_to_setTimer</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_atmpDataTransferStart" messageRef="Message_atmpDataTransferStart" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_setTimer" name="set timer" camunda:class="de.ukhd.process.atmp.service.SetTimer">
      <bpmn:incoming>Flow_start_to_setTimer</bpmn:incoming>
      <bpmn:outgoing>Flow_setTimer_to_query</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_queryResearchSubjects" name="query research subjects" camunda:class="de.ukhd.process.atmp.service.QueryResearchSubjects">
      <bpmn:incoming>Flow_setTimer_to_query</bpmn:incoming>
      <bpmn:incoming>Flow_timer_to_query</bpmn:incoming>
      <bpmn:outgoing>Flow_query_to_subprocess</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="Activity_perSubject" name="per research subject">
      <bpmn:incoming>Flow_query_to_subprocess</bpmn:incoming>
      <bpmn:outgoing>Flow_subprocess_to_timer</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:collection="${atmpResearchSubjects}" camunda:elementVariable="atmpSubject" />
      <bpmn:startEvent id="StartEvent_perSubject">
        <bpmn:outgoing>Flow_substart_to_create</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Activity_createSubjectBundle" name="create subject bundle" camunda:class="de.ukhd.process.atmp.service.CreateSubjectBundle">
        <bpmn:incoming>Flow_substart_to_create</bpmn:incoming>
        <bpmn:outgoing>Flow_create_to_send</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Activity_sendToMedic" name="send to MEDIC" camunda:class="de.ukhd.process.atmp.service.SendToMedic">
        <bpmn:incoming>Flow_create_to_send</bpmn:incoming>
        <bpmn:outgoing>Flow_send_to_subend</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="EndEvent_perSubject">
        <bpmn:incoming>Flow_send_to_subend</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_substart_to_create" sourceRef="StartEvent_perSubject" targetRef="Activity_createSubjectBundle" />
      <bpmn:sequenceFlow id="Flow_create_to_send" sourceRef="Activity_createSubjectBundle" targetRef="Activity_sendToMedic" />
      <bpmn:sequenceFlow id="Flow_send_to_subend" sourceRef="Activity_sendToMedic" targetRef="EndEvent_perSubject" />
    </bpmn:subProcess>
    <bpmn:intermediateCatchEvent id="Event_timerInterval" name="wait">
      <bpmn:incoming>Flow_subprocess_to_timer</bpmn:incoming>
      <bpmn:outgoing>Flow_timer_to_query</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_timerInterval">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${atmpTimerInterval}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:subProcess id="EventSubProcess_stop" name="stop ATMP data transfer" triggeredByEvent="true">
      <bpmn:startEvent id="StartEvent_atmpDataTransferStop" name="stop ATMP data transfer" isInterrupting="true">
        <bpmn:outgoing>Flow_stop_to_stopped</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_atmpDataTransferStop" messageRef="Message_atmpDataTransferStop" />
      </bpmn:startEvent>
      <bpmn:endEvent id="EndEvent_atmpDataTransferStopped" name="stopped">
        <bpmn:incoming>Flow_stop_to_stopped</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_stop_to_stopped" sourceRef="StartEvent_atmpDataTransferStop" targetRef="EndEvent_atmpDataTransferStopped" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_start_to_setTimer" sourceRef="StartEvent_atmpDataTransfer" targetRef="Activity_setTimer" />
    <bpmn:sequenceFlow id="Flow_setTimer_to_query" sourceRef="Activity_setTimer" targetRef="Activity_queryResearchSubjects" />
    <bpmn:sequenceFlow id="Flow_query_to_subprocess" sourceRef="Activity_queryResearchSubjects" targetRef="Activity_perSubject" />
    <bpmn:sequenceFlow id="Flow_subprocess_to_timer" sourceRef="Activity_perSubject" targetRef="Event_timerInterval" />
    <bpmn:sequenceFlow id="Flow_timer_to_query" sourceRef="Event_timerInterval" targetRef="Activity_queryResearchSubjects" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="ukhdde_atmpDataTransfer">
      <bpmndi:BPMNShape id="BPMNShape_start" bpmnElement="StartEvent_atmpDataTransfer">
        <dc:Bounds x="152" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_setTimer" bpmnElement="Activity_setTimer">
        <dc:Bounds x="240" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_query" bpmnElement="Activity_queryResearchSubjects">
        <dc:Bounds x="390" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_subprocess" bpmnElement="Activity_perSubject" isExpanded="true">
        <dc:Bounds x="550" y="80" width="520" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_timer" bpmnElement="Event_timerInterval">
        <dc:Bounds x="1132" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_stopSubProcess" bpmnElement="EventSubProcess_stop" isExpanded="true">
        <dc:Bounds x="240" y="360" width="300" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_start_setTimer" bpmnElement="Flow_start_to_setTimer">
        <di:waypoint x="188" y="200" />
        <di:waypoint x="240" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_setTimer_query" bpmnElement="Flow_setTimer_to_query">
        <di:waypoint x="340" y="200" />
        <di:waypoint x="390" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_query_subprocess" bpmnElement="Flow_query_to_subprocess">
        <di:waypoint x="490" y="200" />
        <di:waypoint x="550" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_subprocess_timer" bpmnElement="Flow_subprocess_to_timer">
        <di:waypoint x="1070" y="200" />
        <di:waypoint x="1132" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_timer_query" bpmnElement="Flow_timer_to_query">
        <di:waypoint x="1150" y="182" />
        <di:waypoint x="1150" y="40" />
        <di:waypoint x="440" y="40" />
        <di:waypoint x="440" y="160" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
